{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgrupinsaat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c685eaf683b649bd8495b38a0d831454"
    }
  ]
}
